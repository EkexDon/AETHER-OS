{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AETHER-OS",
  "version": "0.2.0",
  "identifier": "com.ekin.aetheros",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AETHER-OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:11434 http://127.0.0.1:* http://localhost:*; img-src 'self' asset: data: http://asset.localhost https:; media-src 'self' asset: http://asset.localhost blob: data:; object-src 'self' blob: data:; frame-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "EkexDon",
    "copyright": "Copyright © 2026 EkexDon",
    "homepage": "https://github.com/EkexDon/AETHER-OS",
    "category": "Productivity",
    "shortDescription": "Local-first personal operating system for notes, code and AI",
    "longDescription": "AETHER-OS combines a Markdown vault, a code editor, terminal, browser, calendar, tasks and a local AI agent in one keyboard-first desktop app. Everything stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "depends": ["libssl3 | libssl3t64"]
      },
      "rpm": {
        "depends": ["libssl.so.3()(64bit)", "libcrypto.so.3()(64bit)"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
